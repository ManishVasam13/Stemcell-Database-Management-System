# ---- MySQL connection used by the API ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stemvault
# After running database setup you can switch to the least-privilege
# account created by 07_security.sql: DB_USER=stemvault_app / DB_PASSWORD=StemVault@App123
DB_USER=root
DB_PASSWORD="Sarita1309#"

# ---- account used only by `npm run db:setup` (needs CREATE/DROP/GRANT) ----
